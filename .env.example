# AI Studio / Gemini API Configuration Template
# Copy this file to '.env' (do NOT commit .env):
# cp .env.example .env

# Google AI Studio API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Dark Energy Observatory endpoint / frame config
DARK_ENERGY_FRAME_ID=FRAME_DEO_001
GPS_HYPERSPHERE_DIMENSIONS=5
